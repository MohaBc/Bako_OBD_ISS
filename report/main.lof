\contentsline {figure}{\numberline {15}{\ignorespaces MCP2515 SPI CAN controller module. Interfaces the ESP32 to the J1939 CAN bus via SPI (J17/J18/J19).}}{39}{figure.caption.23}%
\contentsline {figure}{\numberline {16}{\ignorespaces TJA1051T automotive CAN transceiver. Converts MCP2515 logic levels to differential CANH/CANL bus signals.}}{39}{figure.caption.23}%
\contentsline {figure}{\numberline {17}{\ignorespaces SIM7670E LTE Cat-M1 module. Provides 4G cellular connectivity to the VPS cloud backend via GPRS/LTE.}}{39}{figure.caption.24}%
\contentsline {figure}{\numberline {18}{\ignorespaces DS18B20 1-Wire digital temperature sensors (J6, J7, J8). Monitor motor winding, MPPT heatsink, and DC/DC temperatures.}}{39}{figure.caption.24}%
\contentsline {figure}{\numberline {19}{\ignorespaces ACS712-30A Hall-effect current sensor modules (J11, J16). Measure solar panel and MPPT output currents.}}{39}{figure.caption.24}%
\contentsline {figure}{\numberline {20}{\ignorespaces LM2596S-ADJ adjustable buck regulator. Steps down the 12~V vehicle supply to the 3.3~V and 5~V board rails.}}{40}{figure.caption.25}%
