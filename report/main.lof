\contentsline {figure}{\numberline {15}{\ignorespaces MCP2515 SPI CAN controller module. Interfaces the ESP32 to the J1939 CAN bus via SPI (J17/J18/J19).}}{40}{figure.caption.23}%
\contentsline {figure}{\numberline {16}{\ignorespaces TJA1051T automotive CAN transceiver. Converts MCP2515 logic levels to differential CANH/CANL bus signals.}}{40}{figure.caption.23}%
